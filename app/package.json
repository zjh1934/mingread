{
  "name": "langdu-nv-neo",
  "version": "2.4.0",
  "description": "朗读女 Neo —— 面向低视力人群的 Windows 无障碍辅助工具：屏幕放大 + 高对比 + 划词朗读（LensZoom 缩放 · 选中即读 F1 · 本地 NVSA 优先 / Edge 在线兜底的微软神经语音）",
  "productName": "朗读女 Neo",
  "author": "zjh1934",
  "license": "MIT",
  "homepage": "https://github.com/zjh1934/langdu-nv",
  "repository": {
    "type": "git",
    "url": "https://github.com/zjh1934/langdu-nv.git"
  },
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "dev:web": "vite",
    "dev:app": "electron .",
    "dev": "concurrently -k -n vite,electron -c blue,green \"vite\" \"electron .\"",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder",
    "dist": "vite build && electron-builder --win nsis zip",
    "check": "node scripts/check-syntax.js",
    "selfcheck": "python scripts/selfcheck_all.py"
  },
  "dependencies": {
    "node-edge-tts": "1.2.11"
  },
  "devDependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.1.0",
    "electron-builder": "^25.1.0",
    "postcss": "^8.4.41",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.0",
    "zustand": "^4.5.5"
  }
}
